void showSQLError(SQLHANDLE handle, SQLSMALLINT type)
{
    SQLCHAR sqlState[6];
    SQLCHAR message[1024];
    SQLINTEGER nativeError;
    SQLSMALLINT messageLength;

    SQLRETURN ret;
    int i = 1;

    while ((ret = SQLGetDiagRecA(
                type,
                handle,
                i,
                sqlState,
                &nativeError,
                message,
                sizeof(message),
                &messageLength)) != SQL_NO_DATA)
    {
        cout << "SQL State: " << sqlState << endl;
        cout << "Error: " << message << endl;
        i++;
    }
}
SQLHENV environment = NULL;
SQLHDBC connection = NULL;

bool connectToSQL()
{
    SQLRETURN ret;

    // Allocate environment
    ret = SQLAllocHandle(
        SQL_HANDLE_ENV,
        SQL_NULL_HANDLE,
        &environment
    );

    if (!SQL_SUCCEEDED(ret))
    {
        cout << "Failed to allocate SQL environment." << endl;
        return false;
    }

    // Set ODBC version
    ret = SQLSetEnvAttr(
        environment,
        SQL_ATTR_ODBC_VERSION,
        (SQLPOINTER)SQL_OV_ODBC3,
        0
    );

    if (!SQL_SUCCEEDED(ret))
    {
        cout << "Failed to set ODBC version." << endl;
        return false;
    }

    // Allocate connection
    ret = SQLAllocHandle(
        SQL_HANDLE_DBC,
        environment,
        &connection
    );

    if (!SQL_SUCCEEDED(ret))
    {
        cout << "Failed to allocate SQL connection." << endl;
        return false;
    }

    // SQL Server connection string
    SQLCHAR connectionString[] =
        "DRIVER={ODBC Driver 18 for SQL Server};"
        "SERVER=DANISH\\SQLEXPRESS;"
        "DATABASE=student_management;"
        "Trusted_Connection=yes;"
        "TrustServerCertificate=yes;";

    SQLCHAR outputString[1024];
    SQLSMALLINT outputLength;

    // Connect
    ret = SQLDriverConnectA(
        connection,
        NULL,
        connectionString,
        SQL_NTS,
        outputString,
        sizeof(outputString),
        &outputLength,
        SQL_DRIVER_NOPROMPT
    );

    if (SQL_SUCCEEDED(ret))
    {
        cout << "\nConnected to SQL Server successfully!\n";
        return true;
    }
    else
    {
        cout << "\nSQL Server connection failed!\n";
        showSQLError(connection, SQL_HANDLE_DBC);
        return false;
    }
}
void disconnectFromSQL()
{
    if (connection != NULL)
    {
        SQLDisconnect(connection);
        SQLFreeHandle(SQL_HANDLE_DBC, connection);
        connection = NULL;
    }

    if (environment != NULL)
    {
        SQLFreeHandle(SQL_HANDLE_ENV, environment);
        environment = NULL;
    }
}
