bool insertStudentIntoSQL(const student& s)
{
    SQLHSTMT statement = NULL;

    SQLRETURN ret = SQLAllocHandle(
        SQL_HANDLE_STMT,
        connection,
        &statement
    );

    if(!SQL_SUCCEEDED(ret))
    {
        cout << "Failed to create SQL statement." << endl;
        return false;
    }

    SQLCHAR query[] =
        "INSERT INTO student_details "
        "(id, name, age, department, email, phone) "
        "VALUES (?, ?, ?, ?, ?, ?)";

    ret = SQLPrepareA(
        statement,
        query,
        SQL_NTS
    );

    if(!SQL_SUCCEEDED(ret))
    {
        cout << "Failed to prepare SQL query." << endl;
        showSQLError(statement, SQL_HANDLE_STMT);

        SQLFreeHandle(SQL_HANDLE_STMT, statement);

        return false;
    }

    long long id = s.getid();
    string name = s.getName();
    int age = s.getAge();
    string department = s.getDepartment();
    string email = s.getEmail();
    string phone = s.getPhone();

    SQLLEN idLength = 0;
    SQLLEN nameLength = (SQLLEN)name.length();
    SQLLEN ageLength = 0;
    SQLLEN departmentLength = (SQLLEN)department.length();
    SQLLEN emailLength = (SQLLEN)email.length();
    SQLLEN phoneLength = (SQLLEN)phone.length();

    SQLBindParameter(
        statement, 1, SQL_PARAM_INPUT,
        SQL_C_SBIGINT, SQL_BIGINT,
        0, 0, &id, 0, &idLength
    );

    SQLBindParameter(
        statement, 2, SQL_PARAM_INPUT,
        SQL_C_CHAR, SQL_VARCHAR,
        100, 0,
        (SQLPOINTER)name.c_str(),
        (SQLLEN)name.length() + 1,
        &nameLength
    );

    SQLBindParameter(
        statement, 3, SQL_PARAM_INPUT,
        SQL_C_LONG, SQL_INTEGER,
        0, 0, &age, 0, &ageLength
    );

    SQLBindParameter(
        statement, 4, SQL_PARAM_INPUT,
        SQL_C_CHAR, SQL_VARCHAR,
        200, 0,
        (SQLPOINTER)department.c_str(),
        (SQLLEN)department.length() + 1,
        &departmentLength
    );

    SQLBindParameter(
        statement, 5, SQL_PARAM_INPUT,
        SQL_C_CHAR, SQL_VARCHAR,
        200, 0,
        (SQLPOINTER)email.c_str(),
        (SQLLEN)email.length() + 1,
        &emailLength
    );

    SQLBindParameter(
        statement, 6, SQL_PARAM_INPUT,
        SQL_C_CHAR, SQL_VARCHAR,
        20, 0,
        (SQLPOINTER)phone.c_str(),
        (SQLLEN)phone.length() + 1,
        &phoneLength
    );

    ret = SQLExecute(statement);

    if(!SQL_SUCCEEDED(ret))
    {
        cout << "\nFailed to insert student into SQL Server.\n";
        showSQLError(statement, SQL_HANDLE_STMT);

        SQLFreeHandle(SQL_HANDLE_STMT, statement);

        return false;
    }

    SQLFreeHandle(SQL_HANDLE_STMT, statement);

    return true;
}
